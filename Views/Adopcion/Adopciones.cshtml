@model IEnumerable<PC2proyecto.Models.Adopcion>
@{
ViewData["Title"] = "Adopciones Registradas";
}
<div class="card">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title">Adopciones Registradas</h3>
    </div>
@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card-body">
    <p>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Registrar Nueva Adopción
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Mascota</th>
                    <th>Tipo</th>
                    <th>Adoptante</th>
                    <th>Fecha de Adopción</th>
                   
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.Pet.Nombre</td>
                        <td>@item.Pet.Tipo</td>
                        <td>@item.Adopter.Nombre</td>
                        <td>@item.FechaAdopcion.ToString("dd/MM/yyyy")</td>
                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>